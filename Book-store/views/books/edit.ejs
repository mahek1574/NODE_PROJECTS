<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Book - BookVerse</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <nav class="navbar">
    <a href="/" class="navbar-brand">
      BookVerse
    </a>
    <div class="navbar-links">
      <a href="/books" class="btn btn-outline">Back to Books</a>
    </div>
  </nav>

  <div class="container">
    <div class="form-container">
      <div class="form-header">
        <h2>Edit Book</h2>
        <p>Update the details for <%= book.title %>.</p>
      </div>

      <form action="/edit/<%= book._id %>" method="POST" enctype="multipart/form-data">

        <div class="form-group">
          <label>Book Title</label>
          <input type="text" name="title" class="form-control" placeholder="Title" value="<%= book.title %>" required>
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea name="description" class="form-control" placeholder="Description"><%= book.description %></textarea>
        </div>

        <div class="form-group">
          <label>Rating (Out of 10)</label>
          <input type="number" name="rating" class="form-control" placeholder="Rating" value="<%= book.rating %>" step="0.1" min="0" max="10">
        </div>

        <div class="form-group">
          <label>Release Year</label>
          <input type="number" name="year" class="form-control" placeholder="Year" value="<%= book.year %>" min="1000" max="2100">
        </div>

        <div class="form-group">
          <label>Category</label>
          <select name="category" class="form-control">
            <option value="Fiction" <%= book.category === 'Fiction' ? 'selected' : '' %>>Fiction</option>
            <option value="Non-Fiction" <%= book.category === 'Non-Fiction' ? 'selected' : '' %>>Non-Fiction</option>
            <option value="Mystery" <%= book.category === 'Mystery' ? 'selected' : '' %>>Mystery</option>
            <option value="Fantasy" <%= book.category === 'Fantasy' ? 'selected' : '' %>>Fantasy</option>
            <option value="Sci-Fi" <%= book.category === 'Sci-Fi' ? 'selected' : '' %>>Sci-Fi</option>
            <option value="Biography" <%= book.category === 'Biography' ? 'selected' : '' %>>Biography</option>
          </select>
        </div>

        <% if(book.image) { %>
          <div class="form-group">
            <label>Current Cover</label>
            <div class="image-preview">
              <img src="/uploads/<%= book.image %>" width="150" alt="Current cover">
            </div>
          </div>
        <% } %>

        <div class="form-group">
          <label>Update Cover (optional)</label>
          <input type="file" name="image" class="form-control" accept="image/*">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">Update Book</button>

      </form>
    </div>
  </div>

</body>
</html>
