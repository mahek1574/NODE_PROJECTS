<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Book - BookVerse</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <nav class="navbar">
    <a href="/" class="navbar-brand">
      BookVerse
    </a>
    <div class="navbar-links">
      <a href="/books" class="btn btn-outline">Back to Books</a>
    </div>
  </nav>

  <div class="container">
    <div class="form-container">
      <div class="form-header">
        <h2>Add a New Book</h2>
        <p>Fill in the details below to add to your collection.</p>
      </div>

      <form action="/add-book" method="POST" enctype="multipart/form-data">
        
        <div class="form-group">
          <label>Book Title</label>
          <input type="text" name="title" class="form-control" placeholder="E.g., The Hobbit" required>
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea name="description" class="form-control" placeholder="A brief synopsis of the book..."></textarea>
        </div>

        <div class="form-group">
          <label>Rating (Out of 10)</label>
          <input type="number" name="rating" class="form-control" placeholder="8.5" step="0.1" min="0" max="10">
        </div>

        <div class="form-group">
          <label>Release Year</label>
          <input type="number" name="year" class="form-control" placeholder="1937" min="1000" max="2100">
        </div>

        <div class="form-group">
          <label>Category</label>
          <select name="category" class="form-control">
            <option value="Fiction">Fiction</option>
            <option value="Non-Fiction">Non-Fiction</option>
            <option value="Mystery">Mystery</option>
            <option value="Fantasy">Fantasy</option>
            <option value="Sci-Fi">Sci-Fi</option>
            <option value="Biography">Biography</option>
          </select>
        </div>

        <div class="form-group">
          <label>Book Cover</label>
          <input type="file" name="image" class="form-control" accept="image/*">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">Add Book</button>

      </form>
    </div>
  </div>

</body>
</html>