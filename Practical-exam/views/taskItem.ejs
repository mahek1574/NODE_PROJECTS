<div class="task-card status-<%= task.status.toLowerCase().replace(' ', '-') %>">
  <div class="task-card-header">
    <h3 class="task-title"><%= task.title %></h3>
    <span class="status-badge badge-<%= task.status.toLowerCase().replace(' ', '-') %>">
      <%= task.status %>
    </span>
  </div>

  <p class="task-desc"><%= task.description || 'No description provided.' %></p>

  <div class="task-meta">
    <% if (task.category) { %>
      <div class="meta-item category-tag">
        <svg class="icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M10 20H4V4h6v2h2V4h6v4h2V4c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h6v-2zm8.5-4.42l-1.42-1.42L13.5 17.75l-1.92-1.92-1.42 1.42 3.34 3.34 4.96-4.96-1.46-.01z"/></svg>
        <span><%= task.category.name %></span>
      </div>
    <% } %>

    <% if (task.owner) { %>
      <div class="meta-item owner-info">
        <svg class="icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
        <span><%= task.owner.username %></span>
      </div>
    <% } %>
  </div>

  <div class="task-actions">
    <% if (task.status !== 'Completed') { %>
      <form method="POST" action="/tasks/update/<%= task._id %>">
        <input type="hidden" name="status" value="Completed" />
        <button type="submit" class="btn btn-sm btn-success">
          Complete
        </button>
      </form>
      <% if (task.status === 'Pending') { %>
        <form method="POST" action="/tasks/update/<%= task._id %>">
          <input type="hidden" name="status" value="In Progress" />
          <button type="submit" class="btn btn-sm btn-info">
            Start
          </button>
        </form>
      <% } %>
    <% } %>

    <form method="POST" action="/tasks/delete/<%= task._id %>" onsubmit="return confirm('Are you sure you want to delete this task?');">
      <button type="submit" class="btn btn-sm btn-danger">
        Delete
      </button>
    </form>
  </div>
</div>